Package: BiFactorCopulaGAMM
Type: Package
Title: Bi-Factor Copula-Based Mixed Regression Models
Version: 0.1.9
Authors@R: c(person(c("Pavel"), "Krupskii", role = c("aut", "ctb","cph"), email = "pavel.krupskiy@unimelb.edu.au"), person(c("Bouchra","R."), "Nasri", role = c("aut", "ctb","cph"), email = "bouchra.nasri@umontreal.ca"),
